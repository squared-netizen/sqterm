# sqterm's terminfo entry (TERM=sqterm): what sqterm's emulator implements,
# and nothing it does not (squared/docs/programmer/term.md, "What it reads").
# Compiled into the prefix by the package build (12.5):
#
#     tic -x -o "$PREFIX/share/terminfo" terminfo/sqterm.ti
#
# Until then, a program that reads terminfo (ncurses) says the terminal is
# unknown; Android's own shell and tools do not read it.
#
# Keys are xterm's (sq::term::key_bytes): arrows CSI A, SS3 A in keypad
# transmit mode (DECCKM); Home CSI H, End CSI F; F1 to F4 SS3 P to S; the
# rest CSI n ~. Backspace is DEL. No DEC line-drawing set (acsc): with
# U8#1 and a UTF-8 locale, ncurses draws lines with Unicode's box characters.
# Alt sends ESC before the key, never the eighth bit, so no km.
sqterm|sqterm terminal emulator (squared),
	am, bce, mir, msgr, npc, xenl,
	colors#0x100, cols#80, it#8, lines#24, pairs#0x10000,
	U8#1,
	bel=^G, blink=\E[5m, bold=\E[1m, cbt=\E[Z,
	civis=\E[?25l, clear=\E[H\E[2J, cnorm=\E[?25h, cr=\r,
	csr=\E[%i%p1%d;%p2%dr, cub=\E[%p1%dD, cub1=^H,
	cud=\E[%p1%dB, cud1=\n, cuf=\E[%p1%dC, cuf1=\E[C,
	cup=\E[%i%p1%d;%p2%dH, cuu=\E[%p1%dA, cuu1=\E[A,
	dch=\E[%p1%dP, dch1=\E[P, dim=\E[2m, dl=\E[%p1%dM,
	dl1=\E[M, ech=\E[%p1%dX, ed=\E[J, el=\E[K, el1=\E[1K,
	home=\E[H, hpa=\E[%i%p1%dG, ht=^I, hts=\EH,
	ich=\E[%p1%d@, il=\E[%p1%dL, il1=\E[L, ind=\n,
	indn=\E[%p1%dS, invis=\E[8m, is2=\E[?7h,
	kbs=^?, kcbt=\E[Z, kcub1=\EOD, kcud1=\EOB, kcuf1=\EOC,
	kcuu1=\EOA, kdch1=\E[3~, kend=\EOF, kf1=\EOP, kf10=\E[21~,
	kf11=\E[23~, kf12=\E[24~, kf2=\EOQ, kf3=\EOR, kf4=\EOS,
	kf5=\E[15~, kf6=\E[17~, kf7=\E[18~, kf8=\E[19~,
	kf9=\E[20~, khome=\EOH, kich1=\E[2~, knp=\E[6~, kpp=\E[5~,
	nel=\EE, op=\E[39;49m, rc=\E8, rep=%p1%c\E[%p2%{1}%-%db,
	rev=\E[7m, ri=\EM, rin=\E[%p1%dT, ritm=\E[23m,
	rmam=\E[?7l, rmcup=\E[?1049l, rmir=\E[4l,
	rmkx=\E[?1l, rmso=\E[27m, rmul=\E[24m, rs1=\Ec,
	sc=\E7, setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48;5;%p1%d%;m,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
	sgr=\E[0%?%p6%t;1%;%?%p5%t;2%;%?%p2%t;4%;%?%p1%p3%|%t;7%;%?%p4%t;5%;%?%p7%t;8%;m,
	sgr0=\E[m, sitm=\E[3m, smam=\E[?7h,
	smcup=\E[?1049h, smir=\E[4h, smkx=\E[?1h, smso=\E[7m,
	smul=\E[4m, tbc=\E[3g, tsl=\E]2;, fsl=^G, hs,
	u6=\E[%i%d;%dR, u7=\E[6n, u8=\E[?%[;0123456789]c,
	u9=\E[c, vpa=\E[%i%p1%dd,
	BD=\E[?2004l, BE=\E[?2004h, PE=\E[201~, PS=\E[200~,
	RGB, Tc, setrgbb=\E[48;2;%p1%d;%p2%d;%p3%dm,
	setrgbf=\E[38;2;%p1%d;%p2%d;%p3%dm, smxx=\E[9m, rmxx=\E[29m,
